<?xml version="1.0" encoding="utf-8"?>
<!--
    Configuración de seguridad de red.
    Permite cleartext (HTTP) solo para dos hosts de desarrollo:
      - 10.0.2.2       host del emulador Android (localhost de la máquina host).
      - 100.83.123.115 backend expuesto en el tailnet (Tailscale) para pruebas
                       en dispositivo físico.
    Todo el tráfico restante queda forzado a HTTPS.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />

    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">100.83.123.115</domain>
    </domain-config>
</network-security-config>
