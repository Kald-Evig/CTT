# Bases de datos locales — nunca commitear
*.db
*.db-shm
*.db-wal
# Dumps/backups de DB (p. ej. ctt_dev.db.OLD): *.db no los cubre por el sufijo.
# Importante: pueden contener datos personales reales (RUT, correos), no solo seed.
*.db.*

# Caché de Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# Entorno virtual Python
.venv/

# Logs de build y desarrollo
*.log
ctt-mobile/android/.kotlin/

# IDE
.vscode/

# Artefactos sueltos de pruebas manuales
body.json

# Copias de la base y capturas sacadas del teléfono en sesiones de runtime (S22).
# Contienen datos de trabajadores: nunca commitear. Van a una carpeta local fuera
# del repo (ver docs/runbook_s22_ctt130_fase4b.md). El patrón cubre .db y .png.
s22_*/
