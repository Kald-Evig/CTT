# ── Base de datos ────────────────────────────────────────────────────────────
# PostgreSQL de desarrollo (Docker). Para producción definir con credenciales
# reales (AWS RDS o similar).
DATABASE_URL=postgresql+psycopg://postgres:ctt_dev@localhost:5432/ctt_dev

# ── Autenticación ────────────────────────────────────────────────────────────
# "mock"     → resuelve el usuario desde el Bearer token sin validación (demo/UAT)
# "firebase" → valida JWT con firebase-admin (producción, Sección 4.3 del DDT)
AUTH_MODE=mock

# Ruta al service account JSON de Firebase Admin SDK.
# Solo necesaria si AUTH_MODE=firebase Y la app NO corre en GCP con una
# service account de entorno adjunta (Cloud Run, GKE, etc.).
# En GCP dejar comentado: las credenciales llegan por Application Default Credentials.
# GOOGLE_APPLICATION_CREDENTIALS=/ruta/absoluta/al/serviceAccount.json

# ── Reglas de negocio (Sección 5.3 del DDT) ──────────────────────────────────
MAX_NIVEL_PROFUNDIDAD=3
MAX_HIJOS_DIRECTOS=10

# ── Logging de desarrollo ────────────────────────────────────────────────────
# true  (default) → loguea requests a logs/ctt_dev.log
# false           → desactivar en producción para no saturar disco
LOG_REQUESTS=true
